# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Firebase credentials
key.json
**/key.json
firebase-key.json
service-account-key.json

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.expo/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Ignore shell scripts except deployment scripts
*.sh
!apps/server/deploy.sh
!apps/server/check-deployment.sh

# Ignore all markdown files except specific ones
*.md
!/README.md
!docs/CONTRIBUTING.md
!CHANGELOG.md

# IDEs and editors
.vscode/
apps/server/key.json

# Firebase emulator logs
firestore-debug.log
firebase-debug.log
ui-debug.log

# Server API documentation (the repo ignores *.md by default)
!apps/server/docs/*.md
