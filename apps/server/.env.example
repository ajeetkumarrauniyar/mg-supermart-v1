PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-testing-only

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id-for-testing-only

# Image Management Configuration (will be simulated without real API keys)
GOOGLE_CUSTOM_SEARCH_API_KEY=your-google-custom-search-api-key-for-testing-only
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-google-custom-search-engine-id-for-testing-only
BING_SEARCH_API_KEY=your-bing-search-api-key-for-testing-only

# Cloud Storage Configuration (will be simulated)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name-for-testing-only
CLOUDINARY_API_KEY=your-cloudinary-api-key-for-testing-only
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-for-testing-only

# Image Processing Configuration
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_PRODUCT=5
IMAGE_QUALITY_THRESHOLD=0.7
PROCESSING_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Store configuration. All values are required; the server refuses to start
# if any value is missing or invalid. There are no code defaults.
# ---------------------------------------------------------------------------
# Store location and hard straight-line delivery radius in km
STORE_LAT=26.48872184
STORE_LNG=84.98157501
DELIVERY_RADIUS_KM=5
# Minimum eligible order value in rupees
MIN_ORDER_VALUE=500
# Fees: amount in rupees; *_WAIVED_AT is a subtotal threshold, or empty = never waived
# Placeholder values: the real fees have not been decided yet and must be set
# explicitly per environment before going live.
DELIVERY_FEE_AMOUNT=40
DELIVERY_FEE_WAIVED_AT=
HANDLING_FEE_AMOUNT=5
HANDLING_FEE_WAIVED_AT=

# Legacy admin-panel compatibility only: value written to order.shippingAddress.state
# (the address model does not collect state). Not a business rule; empty allowed.
LEGACY_SHIPPING_STATE=Bihar
