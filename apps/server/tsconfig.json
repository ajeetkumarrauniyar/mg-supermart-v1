{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "sourceMap": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "types/**/*.d.ts",
    "@types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test-real-config.ts",
    "src/setup-firebase.ts",
    "src/**/*.test.ts",
    "src/test/**"
  ],
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  }
}
